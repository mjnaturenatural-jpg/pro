# Database
MONGODB_URI=mongodb://localhost:27017/mj-nature-naturals

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-long-random-string

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret — create a webhook in the Razorpay dashboard
# (Settings > Webhooks) pointing at https://YOUR-DOMAIN/api/payments/webhook
# with events payment.authorized, payment.captured, payment.failed, order.paid,
# and paste the secret you choose there into this variable.
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin seed (used only on first run)
ADMIN_EMAIL=admin@mjnaturals.in
ADMIN_PASSWORD=ChangeMe@123

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# TODO(client): production site URL used for canonical links, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://www.mjnaturenatural.com
NEXT_PUBLIC_APP_NAME=MJ Nature Natural
# TODO(client): verified business WhatsApp number (international format, no +). Leave blank to hide WhatsApp actions.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# TODO(client): optional analytics IDs. Leave blank to disable tracking.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Shiprocket (server-side only — never commit real values)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# TODO(client): warehouse pickup pincode for Shiprocket rate checks.
SHIPROCKET_PICKUP_POSTCODE=
# TODO(client): pickup location nickname exactly as saved in the Shiprocket dashboard.
SHIPROCKET_PICKUP_LOCATION=
# Test-only overrides used by scripts/shipping-tests.ps1 (leave unset in production).
# SHIPROCKET_BASE_URL=http://127.0.0.1:4600/v1/external
# SHIPROCKET_TIMEOUT_MS=1000
# Login circuit-breaker cooldown in ms (default 5 min). Only shorten in tests.
# SHIPROCKET_LOGIN_COOLDOWN_MS=3000
# Cached token TTL in ms (default 20 h). Set 0 in tests to force a fresh login.
# SHIPROCKET_TOKEN_TTL_MS=0
