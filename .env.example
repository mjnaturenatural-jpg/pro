# Database
MONGODB_URI=mongodb://localhost:27017/mj-nature-naturals

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-long-random-string

# Payments — Razorpay credentials are not stored in the repo.
# The key id is public (it ships to the browser) and lives in
# src/lib/razorpay.ts as a fallback; set these only in the deployment
# environment (never commit real values):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook signing secret — create a webhook in the Razorpay dashboard
# (Settings > Webhooks) pointing at https://YOUR-DOMAIN/api/payments/webhook
# with events payment.authorized, payment.captured, payment.failed, order.paid.
# RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin seed (used only on first run)
ADMIN_EMAIL=admin@mjnaturals.in
ADMIN_PASSWORD=ChangeMe@123

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# TODO(client): production site URL used for canonical links, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://www.mjnaturenatural.com
NEXT_PUBLIC_APP_NAME=MJ Nature Natural
# Verified business WhatsApp number (international format, no +). Defaults to the
# built-in verified number; override in Site Settings → WhatsApp if it changes.
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# TODO(client): optional analytics IDs. Leave blank to disable tracking.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Delhivery (server-side only — never commit real values)
DELIVERY_API_TOKEN=
DELIVERY_BASE_URL=https://track.delhivery.com
# Warehouse pickup pincode for Delhivery serviceability checks.
DELIVERY_PICKUP_POSTCODE=
# Pickup location nickname exactly as registered in Delhivery One.
DELIVERY_PICKUP_LOCATION=
# Return/seller details used for legacy shipment creation.
DELIVERY_RETURN_NAME=
DELIVERY_RETURN_ADDRESS=
DELIVERY_RETURN_CITY=
DELIVERY_RETURN_STATE=
DELIVERY_RETURN_PHONE=
# Optional: leave blank when no GSTIN applies.
DELIVERY_SELLER_GSTIN=
# Optional request timeout in milliseconds (default 8000).
# DELIVERY_TIMEOUT_MS=8000
